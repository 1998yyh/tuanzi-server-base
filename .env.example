# 应用配置
NODE_ENV=development
PORT=3000

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_password
DB_DATABASE=tuanzi_server

# JWT 配置
JWT_SECRET=your-super-secret-key-change-in-production

# CORS 配置（逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# JWT 过期时间（秒）：access token 默认 7200（2 小时），refresh token 默认 604800（7 天）
JWT_EXPIRES_IN=7200
JWT_REFRESH_EXPIRES_IN=604800

# Agent 模块配置：API Key 加密密钥（64 个十六进制字符 = 32 字节，可用 `openssl rand -hex 32` 生成）
# Agent 的 provider/model/apiKey 均存数据库（apiKey 加密存储），无需在此配置 LLM 连接信息
AGENT_ENCRYPTION_KEY=your-64-hex-char-encryption-key-here

# 对外可访问的服务地址（AI 视频/音频生成的参考素材 URL 会拼上此前缀，
# 远端模型服务需要能公网拉取；本地开发填 http://localhost:3000 即可，但远端拉不到时参考音视频会失败）
PUBLIC_BASE_URL=http://localhost:3000

# LangSmith 调试追踪（可选，仅开发环境使用，API Key 从 https://smith.langchain.com 获取）
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=tuanzi-agents
